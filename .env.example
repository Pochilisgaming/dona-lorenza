# Database URL con connection pooling (para Neon en Vercel Serverless - pgbouncer)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/dona_lorenza?sslmode=require&pgbouncer=true"

# Direct URL directa sin pooler (para migraciones de Prisma)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/dona_lorenza?sslmode=require"

# NextAuth secret (generar con `openssl rand -base64 32`)
AUTH_SECRET="dona_lorenza_super_secret_jwt_key_2026_dev_env"
NEXTAUTH_URL="http://localhost:3000"
